# Backend Configuration
PORT=8000
# Database Configuration (PostgreSQL for persistent production, falls back to SQLite for local development)
# Example PostgreSQL: postgresql://username:password@ep-sample-pooler.us-east-1.postgres.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///./database/vendor_onboarding.db

# Optional OpenAI API Key for AI Risk Insights (Leave empty to use deterministic mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
